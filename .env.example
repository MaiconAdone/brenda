# Copie para .env e preencha. O .env NUNCA vai para o repositório.

# Chave gratuita do Portal da Transparência (https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email)
PORTAL_TRANSPARENCIA_API_KEY=

# Sal secreto para o hash de pessoas físicas. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Trocar o sal muda todos os identificadores de pessoa.
LUPA_SALT=

# Neo4j (Docker Compose)
NEO4J_USER=neo4j
NEO4J_PASSWORD=troque-esta-senha

# Diretórios (opcional)
LUPA_DATA_DIR=data
LUPA_CONFIG_DIR=config
LUPA_LOG_DIR=logs
